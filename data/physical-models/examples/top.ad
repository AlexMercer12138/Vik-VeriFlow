{
  "format": "vik-veriflow.arch-design",
  "schemaVersion": 2,
  "module": "demo_top",
  "ports": [
    {
      "name": "uart_tx",
      "direction": "output"
    },
    {
      "name": "uart_rx",
      "direction": "input"
    }
  ],
  "instances": [],
  "logic": [],
  "connections": [],
  "interfacePorts": [],
  "interfaceOverrides": {},
  "interfaceConnections": [],
  "defaults": {
    "uart_tx.value": "1'b0"
  },
  "export": {},
  "presentation": {},
  "physical": {
    "board": "carrier.board.json",
