{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:veriflow:physical-model:v1",
  "title": "VeriFlow physical interface model V1",
  "description": "Fields support constraint generation, pin/electrical checks or model mappings. The extension consumes board/fixed/expansion models; daughtercard and assembly are data contracts. Cross-document semantics require validation.",
  "oneOf": [
    {
      "$ref": "#/definitions/fixed"
    },
    {
      "$ref": "#/definitions/expansion"
    },
    {
      "$ref": "#/definitions/board"
    },
    {
      "$ref": "#/definitions/daughtercard"
    },
    {
      "$ref": "#/definitions/assembly"
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "memberId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![/\\\\])(?!.*[\\r\\n\\u0000]).+$"
    },
    "interfaceDefinition": {
      "oneOf": [
        {
          "$ref": "#/definitions/relativePath"
        },
        {
          "type": "string",
          "pattern": "^library:interfaces/[A-Za-z0-9_][A-Za-z0-9_.-]*\\.json$"
        }
      ]
    },
    "pair": {
      "type": "object",
      "properties": {
        "positive": {
          "$ref": "#/definitions/memberId"
        },
        "negative": {
          "$ref": "#/definitions/memberId"
        }
      },
      "required": [
        "positive",
        "negative"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/memberId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "selection": {
          "enum": [
            "together",
            "individual"
          ],
          "default": "individual"
        }
      },
      "required": [
        "id",
        "members"
      ],
      "additionalProperties": false
    },
    "rail": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "millivolts": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "bank": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/memberId"
        },
        "supplyRail": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "enum": [
            "hp",
            "hr",
            "hd",
            "gt"
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "reservation": {
      "enum": [
        "warn",
        "forbid"
      ]
    },
    "fpgaPin": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/memberId"
        },
        "bank": {
          "$ref": "#/definitions/memberId"
        },
        "reservation": {
          "$ref": "#/definitions/reservation"
        },
        "clockCapable": {
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "definition": {
          "$ref": "#/definitions/interfaceDefinition"
        },
        "function": {
          "$ref": "#/definitions/id"
        }
      },
      "required": [
        "id",
        "definition"
      ],
      "additionalProperties": false
    },
    "boardRoute": {
      "type": "object",
      "properties": {
        "interface": {
          "$ref": "#/definitions/id"
        },
        "member": {
          "$ref": "#/definitions/memberId"
        },
        "pin": {
          "$ref": "#/definitions/memberId"
        }
      },
      "required": [
        "interface",
        "member",
        "pin"
      ],
      "additionalProperties": false
    },
    "mount": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "card": {
          "$ref": "#/definitions/relativePath"
        },
        "installed": {
          "type": "boolean",
          "default": true
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attachment"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "card",
        "connections"
      ],
      "additionalProperties": false
    },
    "interfaceEndpoint": {
      "type": "object",
      "properties": {
        "mount": {
          "$ref": "#/definitions/id"
        },
        "interface": {
          "$ref": "#/definitions/id"
        }
      },
      "required": [
        "interface"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "mount": {
          "$ref": "#/definitions/id"
        },
        "interface": {
          "$ref": "#/definitions/id"
        },
        "member": {
          "$ref": "#/definitions/memberId"
        }
      },
      "required": [
        "interface",
        "member"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "interface": {
          "$ref": "#/definitions/interfaceEndpoint"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/memberId"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "interface"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "groups"
          ]
        },
        {
          "required": [
            "members"
          ]
        }
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/source"
        },
        "port": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/definitions/hdlIdentifier"
            },
            "bit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source",
        "port"
      ],
      "additionalProperties": false
    },
    "railSetting": {
      "type": "object",
      "properties": {
        "rail": {
          "$ref": "#/definitions/id"
        },
        "millivolts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "rail",
        "millivolts"
      ],
      "additionalProperties": false
    },
    "design": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ad"
            },
            "path": {
              "$ref": "#/definitions/relativePath"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "hdl"
            },
            "path": {
              "$ref": "#/definitions/relativePath"
            },
            "module": {
              "$ref": "#/definitions/hdlIdentifier"
            }
          },
          "required": [
            "kind",
            "path",
            "module"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fixed": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "fixed"
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/memberId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "function": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.-]*$": {
              "$ref": "#/definitions/functionDirections"
            }
          },
          "additionalProperties": false
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/group"
          },
          "minItems": 1
        },
        "differentialPairs": {
          "description": "Functional differential pairs: both members must be selected together.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/pair"
          },
          "minItems": 1
        },
        "bus": {
          "$ref": "#/definitions/bus"
        }
      },
      "required": [
        "kind",
        "signals",
        "function"
      ],
      "additionalProperties": false
    },
    "expansion": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "expansion"
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/memberId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/group"
          },
          "minItems": 1
        },
        "differentialPairs": {
          "description": "Differential capability only: either member can be used independently as a single-ended signal when board electrical rules allow it.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/pair"
          },
          "minItems": 1
        },
        "bus": {
          "$ref": "#/definitions/bus"
        }
      },
      "required": [
        "kind",
        "signals"
      ],
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "board"
        },
        "vendor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Device vendor key used to select the generator and device rules; e.g. amd, intel or lattice."
        },
        "device": {
          "type": "string",
          "minLength": 1,
          "description": "Complete device part including package; selects device rules and device assignments."
        },
        "rails": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rail"
          },
          "minItems": 1
        },
        "banks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/bank"
          },
          "minItems": 1
        },
        "fpgaPins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fpgaPin"
          },
          "minItems": 1
        },
        "differentialPairs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pair"
          },
          "minItems": 1
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/instance"
          },
          "minItems": 1
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/boardRoute"
          },
          "minItems": 1
        },
        "clocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/boardClock"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "vendor",
        "device",
        "fpgaPins",
        "interfaces",
        "routes"
      ],
      "additionalProperties": false
    },
    "daughtercard": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "daughtercard"
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/instance"
          },
          "minItems": 1
        },
        "expansions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/instance"
          },
          "minItems": 1
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cardMapping"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "expansions",
        "interfaces",
        "mappings"
      ],
      "additionalProperties": false
    },
    "assembly": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "assembly"
        },
        "design": {
          "$ref": "#/definitions/design"
        },
        "board": {
          "$ref": "#/definitions/relativePath"
        },
        "mounts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/mount"
          },
          "minItems": 1
        },
        "railVoltages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/railSetting"
          },
          "minItems": 1
        },
        "selections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/selection"
          },
          "minItems": 1
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/binding"
          },
          "minItems": 1
        },
        "export": {
          "type": "object",
          "properties": {
            "format": {
              "enum": [
                "xdc",
                "qsf",
                "lpf",
                "pcf"
              ]
            },
            "path": {
              "$ref": "#/definitions/relativePath"
            }
          },
          "required": [
            "format",
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "design",
        "board"
      ],
      "additionalProperties": false
    },
    "hdlIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
    },
    "functionDirections": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z0-9_][A-Za-z0-9_.-]*$": {
          "enum": [
            "input",
            "output",
            "inout"
          ]
        }
      },
      "additionalProperties": false
    },
    "cardMapping": {
      "type": "object",
      "properties": {
        "interface": {
          "$ref": "#/definitions/id"
        },
        "expansion": {
          "$ref": "#/definitions/id"
        },
        "signals": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z0-9_][A-Za-z0-9_.-]*$": {
              "$ref": "#/definitions/memberId"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "interface",
        "expansion",
        "signals"
      ],
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "properties": {
        "boardInterface": {
          "$ref": "#/definitions/id"
        },
        "cardExpansion": {
          "$ref": "#/definitions/id"
        }
      },
      "required": [
        "boardInterface",
        "cardExpansion"
      ],
      "additionalProperties": false
    },
    "boardClock": {
      "type": "object",
      "description": "Actual board oscillator frequency, not a constraint command. For differential clocks reference the positive member only.",
      "properties": {
        "interface": {
          "$ref": "#/definitions/id"
        },
        "member": {
          "$ref": "#/definitions/memberId"
        },
        "frequencyHz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "interface",
        "member",
        "frequencyHz"
      ],
      "additionalProperties": false
    },
    "bus": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/memberId"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/definitions/memberId"
            },
            "minItems": 1,
            "maxItems": 4096,
            "uniqueItems": true
          }
        ]
      }
    }
  }
}
