{
  "$schema": "../../schemas/physical-interface-model.schema.json",
  "format": "veriflow-board-assembly",
  "schemaVersion": 1,
  "id": "assembly.demo.hdmi",
  "revision": "1",
  "name": "示例 HDMI 工程",
  "description": "Select TMDS only. DDC, HPD and CEC mappings remain recorded for later selection.",
  "design": {
    "kind": "ad",
    "path": "top.ad"
  },
  "board": {
    "path": "carrier.board.json",
    "id": "board.demo.carrier",
    "revision": "rev-a"
  },
  "mounts": [
    {
      "id": "video0",
      "card": {
        "path": "hdmi.daughtercard.json",
        "id": "daughtercard.demo.hdmi",
        "revision": "rev-a"
      },
      "installed": true,
      "connections": [
        {
          "boardInterface": "J1",
          "cardExpansion": "EXT0"
        }
      ]
    }
  ],
  "boardSettings": [
    {
      "selector": "JP1",
      "value": "header"
    }
  ],
  "railVoltages": [],
  "selections": [
    {
      "interface": {
        "kind": "daughtercard",
        "mount": "video0",
        "interface": "HDMI0"
      },
      "groups": [
        "tmds"
      ]
    }
  ],
  "bindings": [
    {
      "source": {
        "kind": "daughtercard",
        "mount": "video0",
        "interface": "HDMI0",
        "member": "data0_p"
      },
      "port": {
        "name": "hdmi_data_p",
        "bit": 0
      },
      "ioStandard": "TMDS_33"
    },
    {
      "source": {
        "kind": "daughtercard",
        "mount": "video0",
        "interface": "HDMI0",
        "member": "data0_n"
      },
      "port": {
        "name": "hdmi_data_n",
        "bit": 0
      },
      "ioStandard": "TMDS_33"
    },
    {
      "source": {
        "kind": "daughtercard",
        "mount": "video0",
        "interface": "HDMI0",
        "member": "data1_p"
      },
      "port": {
        "name": "hdmi_data_p",
        "bit": 1
      },
      "ioStandard": "TMDS_33"
    },
    {
      "source": {
        "kind": "daughtercard",
        "mount": "video0",
        "interface": "HDMI0",
        "member": "data1_n"
      },
      "port": {
        "name": "hdmi_data_n",
        "bit": 1
      },
      "ioStandard": "TMDS_33"
    },
    {
      "source": {
        "kind": "daughtercard",
        "mount": "video0",
        "interface": "HDMI0",
        "member": "data2_p"
      },
      "port": {
