        "member": "data2_n"
      },
      "port": {
        "name": "hdmi_data_n",
        "bit": 2
      },
      "ioStandard": "TMDS_33"
    },
    {
      "source": {
        "kind": "daughtercard",
        "mount": "video0",
        "interface": "HDMI0",
        "member": "clock_p"
      },
      "port": {
        "name": "hdmi_clock_p"
      },
      "ioStandard": "TMDS_33"
    },
    {
      "source": {
        "kind": "daughtercard",
        "mount": "video0",
        "interface": "HDMI0",
        "member": "clock_n"
      },
      "port": {
        "name": "hdmi_clock_n"
      },
      "ioStandard": "TMDS_33"
