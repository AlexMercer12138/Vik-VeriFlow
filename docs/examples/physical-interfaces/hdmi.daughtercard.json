{
  "$schema": "../../schemas/physical-interface-model.schema.json",
  "format": "veriflow-daughtercard",
  "schemaVersion": 1,
  "id": "daughtercard.demo.hdmi",
  "revision": "rev-a",
  "name": "示例 HDMI 子卡",
  "description": "A functional HDMI interface mapped directly to the signal IDs of one expansion interface.",
  "expansions": [
    {
      "id": "EXT0",
      "definition": {
        "path": "header40.expansion.json",
        "id": "expansion.demo.header40",
        "revision": "1"
      }
    }
  ],
  "interfaces": [
    {
      "id": "HDMI0",
      "definition": {
        "path": "hdmi.fixed.json",
        "id": "fixed.hdmi.fpga",
        "revision": "1"
      },
      "function": "hdmi-source"
    }
  ],
  "mappings": [
    {
      "interface": "HDMI0",
      "expansion": "EXT0",
      "signals": {
        "data0_p": "dp0_p",
        "data0_n": "dp0_n",
        "data1_p": "dp1_p",
        "data1_n": "dp1_n",
        "data2_p": "dp2_p",
        "data2_n": "dp2_n",
        "clock_p": "dp3_p",
        "clock_n": "dp3_n",
        "ddc_scl": "io0",
        "ddc_sda": "io1",
        "hpd": "io2",
        "cec": "io3"
      }
    }
  ]
}
