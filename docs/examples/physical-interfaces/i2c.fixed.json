    "i2c-slave": {
      "scl": "inout",
      "sda": "inout"
    }
  },
  "signals": [
    {
      "id": "scl"
    },
    {
      "id": "sda"
    }
  ],
  "groups": [
    {
      "id": "data",
      "name": "SCL / SDA",
      "members": [
        "scl",
        "sda"
      ],
      "selection": "together"
