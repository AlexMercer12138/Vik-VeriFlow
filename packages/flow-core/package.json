{
  "name": "@veriflow/flow-core",
  "version": "1.5.2",
  "description": "Shared project, configuration, simulation, and log primitives for Vik-VeriFlow.",
  "type": "commonjs",
  "license": "MIT",
  "author": "AlexMercer12138",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexMercer12138/Vik-VeriFlow.git",
    "directory": "packages/flow-core"
  },
  "homepage": "https://github.com/AlexMercer12138/Vik-VeriFlow#readme",
  "bugs": {
    "url": "https://github.com/AlexMercer12138/Vik-VeriFlow/issues"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./logParser": {
      "types": "./dist/logParser.d.ts",
      "require": "./dist/logParser.js",
      "default": "./dist/logParser.js"
    },
    "./nativeSimulatorBackend": {
      "types": "./dist/nativeSimulatorBackend.d.ts",
      "require": "./dist/nativeSimulatorBackend.js",
      "default": "./dist/nativeSimulatorBackend.js"
    },
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "require": "./dist/defaults.js",
      "default": "./dist/defaults.js"
    },
    "./globalConfigStore": {
      "types": "./dist/globalConfigStore.d.ts",
      "require": "./dist/globalConfigStore.js",
      "default": "./dist/globalConfigStore.js"
    },
    "./pathStyle": {
      "types": "./dist/pathStyle.d.ts",
      "require": "./dist/pathStyle.js",
      "default": "./dist/pathStyle.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "require": "./dist/project.js",
      "default": "./dist/project.js"
    },
    "./projectStore": {
      "types": "./dist/projectStore.d.ts",
      "require": "./dist/projectStore.js",
      "default": "./dist/projectStore.js"
    },
    "./simulation": {
      "types": "./dist/simulation.d.ts",
      "require": "./dist/simulation.js",
      "default": "./dist/simulation.js"
    },
    "./simulatorBackendRegistry": {
      "types": "./dist/simulatorBackendRegistry.d.ts",
      "require": "./dist/simulatorBackendRegistry.js",
      "default": "./dist/simulatorBackendRegistry.js"
    },
    "./templateEngine": {
      "types": "./dist/templateEngine.d.ts",
      "require": "./dist/templateEngine.js",
      "default": "./dist/templateEngine.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "typesVersions": {
    "*": {
      "defaults": [
        "dist/defaults.d.ts"
      ],
      "globalConfigStore": [
        "dist/globalConfigStore.d.ts"
      ],
      "logParser": [
        "dist/logParser.d.ts"
      ],
      "nativeSimulatorBackend": [
        "dist/nativeSimulatorBackend.d.ts"
      ],
      "pathStyle": [
        "dist/pathStyle.d.ts"
      ],
      "project": [
        "dist/project.d.ts"
      ],
      "projectStore": [
        "dist/projectStore.d.ts"
      ],
      "simulation": [
        "dist/simulation.d.ts"
      ],
      "simulatorBackendRegistry": [
        "dist/simulatorBackendRegistry.d.ts"
      ],
      "templateEngine": [
        "dist/templateEngine.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build:shared --prefix ../..",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  }
}
