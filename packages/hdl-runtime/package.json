{
  "name": "@veriflow/hdl-runtime",
  "version": "1.5.0",
  "description": "Tree-sitter HDL parsing, indexing, and dependency runtime for Vik-VeriFlow.",
  "type": "commonjs",
  "license": "MIT",
  "author": "AlexMercer12138",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexMercer12138/Vik-VeriFlow.git",
    "directory": "packages/hdl-runtime"
  },
  "homepage": "https://github.com/AlexMercer12138/Vik-VeriFlow#readme",
  "bugs": {
    "url": "https://github.com/AlexMercer12138/Vik-VeriFlow/issues"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dependencyAnalyzer": {
      "types": "./dist/dependencyAnalyzer.d.ts",
      "require": "./dist/dependencyAnalyzer.js",
      "default": "./dist/dependencyAnalyzer.js"
    },
    "./archDesignDefinitionReference": {
      "types": "./dist/archDesignDefinitionReference.d.ts",
      "require": "./dist/archDesignDefinitionReference.js",
      "default": "./dist/archDesignDefinitionReference.js"
    },
    "./parserClient": {
      "types": "./dist/parserClient.d.ts",
      "require": "./dist/parserClient.js",
      "default": "./dist/parserClient.js"
    },
    "./parserQueue": {
      "types": "./dist/parserQueue.d.ts",
      "require": "./dist/parserQueue.js",
      "default": "./dist/parserQueue.js"
    },
    "./parserWorker": {
      "types": "./dist/parserWorker.d.ts",
      "require": "./dist/parserWorker.js",
      "default": "./dist/parserWorker.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "require": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./workspaceHdlIndex": {
      "types": "./dist/workspaceHdlIndex.d.ts",
      "require": "./dist/workspaceHdlIndex.js",
      "default": "./dist/workspaceHdlIndex.js"
    },
    "./workspaceIndexStore": {
      "types": "./dist/workspaceIndexStore.d.ts",
      "require": "./dist/workspaceIndexStore.js",
      "default": "./dist/workspaceIndexStore.js"
    },
    "./workspaceIndexTypes": {
      "types": "./dist/workspaceIndexTypes.d.ts",
      "require": "./dist/workspaceIndexTypes.js",
      "default": "./dist/workspaceIndexTypes.js"
    }
  },
  "typesVersions": {
    "*": {
      "archDesignDefinitionReference": [
        "dist/archDesignDefinitionReference.d.ts"
      ],
      "dependencyAnalyzer": [
        "dist/dependencyAnalyzer.d.ts"
      ],
      "parserClient": [
        "dist/parserClient.d.ts"
      ],
      "parserQueue": [
        "dist/parserQueue.d.ts"
      ],
      "parserWorker": [
        "dist/parserWorker.d.ts"
      ],
      "protocol": [
        "dist/protocol.d.ts"
      ],
      "workspaceHdlIndex": [
        "dist/workspaceHdlIndex.d.ts"
      ],
      "workspaceIndexStore": [
        "dist/workspaceIndexStore.d.ts"
      ],
      "workspaceIndexTypes": [
        "dist/workspaceIndexTypes.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@veriflow/flow-core": "1.5.0",
    "@veriflow/hdl-core": "1.5.0",
    "web-tree-sitter": "0.26.11"
  }
}
