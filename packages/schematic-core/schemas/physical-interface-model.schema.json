{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:veriflow:physical-model:v1",
  "title": "VeriFlow constraint profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "extension",
    "constraints",
    "interfaces"
  ],
  "properties": {
    "kind": {
      "enum": [
        "board",
        "daughtercard"
      ]
    },
    "extension": {
      "type": "string",
      "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "constraints": {
      "type": "string",
      "maxLength": 20000000
    },
    "interfaces": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "signals"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "direction",
                "pins"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
                },
                "direction": {
                  "enum": [
                    "input",
                    "output",
                    "inout"
                  ]
                },
                "pins": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4096,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
