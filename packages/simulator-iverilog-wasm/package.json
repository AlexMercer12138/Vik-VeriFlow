{
  "name": "@veriflow/simulator-iverilog-wasm",
  "version": "1.5.1",
  "description": "CommonJS-safe Icarus Verilog WASM adapter for Vik-VeriFlow.",
  "type": "commonjs",
  "license": "MIT",
  "author": "AlexMercer12138",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexMercer12138/Vik-VeriFlow.git",
    "directory": "packages/simulator-iverilog-wasm"
  },
  "homepage": "https://github.com/AlexMercer12138/Vik-VeriFlow#readme",
  "bugs": {
    "url": "https://github.com/AlexMercer12138/Vik-VeriFlow/issues"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@veriflow/flow-core": "1.5.1",
    "@veriflow/iverilog-wasm": "0.1.4"
  }
}
