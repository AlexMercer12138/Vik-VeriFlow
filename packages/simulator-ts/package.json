{
  "name": "@veriflow/simulator-ts",
  "version": "1.5.2",
  "private": true,
  "description": "Experimental project-owned Verilog-2005 simulator core.",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.1"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "benchmark": "npm run build && node benchmark/fourStateVector.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@veriflow/flow-core": "1.5.2"
  }
}
