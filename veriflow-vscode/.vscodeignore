.vscode/**
.vscode-test/**
node_modules/**
src/**
out/**
scripts/**
webview/**
tsconfig.json
.nvmrc
.gitignore
**/*.ts
**/*.map

# The external ESM worker and WASM runtime is copied into dist verbatim.
!dist/vendor/**

# Generated web assets are required in the packaged extension.
media/waveform/**
!media/waveform/index.html
!media/waveform/index.css
!media/waveform/index.js
!media/waveform/viewer-core.js
!media/waveform/viewer-transport.js
media/schematic/**
!media/schematic/index.html
!media/schematic/index.css
!media/schematic/index.js

media/constraints/**
!media/constraints/index.html
!media/constraints/index.css
!media/constraints/index.js
