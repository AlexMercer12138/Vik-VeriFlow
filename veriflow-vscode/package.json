{
  "name": "veriflow",
  "displayName": "Verilog Design Flow",
  "description": "Verilog design workflow for VS Code: analyze, compile, simulate, edit schematics, view waveforms, and generate testbenches",
  "icon": "media/icon.png",
  "version": "1.5.3",
  "publisher": "Vikai-mercer",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "verilog",
    "systemverilog",
    "simulation",
    "testbench",
    "fpga",
    "rtl",
    "iverilog",
    "vcs",
    "waveform",
    "vcd"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexMercer12138/Vik-VeriFlow.git",
    "directory": "veriflow-vscode"
  },
  "activationEvents": [
    "workspaceContains:**/*.v",
    "workspaceContains:**/*.sv",
    "workspaceContains:**/*.st"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "veriflow.boardLibrary",
        "displayName": "VeriFlow Board Library Editor",
        "selector": [{ "filenamePattern": "*.vfboard" }],
        "priority": "default"
      },
      {
        "viewType": "veriflow.waveformEditor",
        "displayName": "VeriFlow Waveform Viewer",
        "selector": [
          {
            "filenamePattern": "*.vcd"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "veriflow.schematicEditor",
        "displayName": "VeriFlow Schematic Editor",
        "selector": [
          {
            "filenamePattern": "*.v"
          },
          {
            "filenamePattern": "*.sv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "veriflow.archDesignEditor",
        "displayName": "VeriFlow Arch Design Editor",
        "selector": [
          {
            "filenamePattern": "*.ad"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "veriflow.simulationTask",
        "displayName": "VeriFlow Simulation Task",
        "selector": [
          {
            "filenamePattern": "*.st"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".ad",
          ".st"
        ]
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "views": {
      "veriflow": [
        {
          "id": "veriflow.files",
          "type": "webview",
          "name": "Module Browser",
          "icon": "$(files)",
          "contextualTitle": "Module Browser"
        },
        {
          "id": "veriflow.design",
          "name": "Architecture Design",
          "icon": "$(circuit-board)",
          "contextualTitle": "Architecture Design"
        },
        {
          "id": "veriflow.modules",
          "name": "Simulation Task",
          "icon": "$(circuit-board)",
          "contextualTitle": "Simulation Task"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "veriflow.design",
        "contents": "[Create Architecture Design](command:veriflow.createArchDesign)"
      },
      {
        "view": "veriflow.modules",
        "contents": "[Create Simulation Task](command:veriflow.newSimulationTask)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "veriflow",
          "title": "VeriFlow",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "veriflow.analyze",
        "title": "Analyze Dependencies",
        "icon": "$(search)"
      },
      {
        "command": "veriflow.simulate",
        "title": "Compile & Simulate",
        "icon": "$(run)"
      },
      {
        "command": "veriflow.openWave",
        "title": "Open Waveform",
        "icon": "$(pulse)"
      },
      {
        "command": "veriflow.openVcdViewer",
        "title": "Open VCD in VeriFlow Viewer",
        "icon": "$(pulse)"
      },
      {
        "command": "veriflow.formatHdl",
        "title": "Format Verilog/SystemVerilog",
        "category": "VeriFlow",
        "enablement": "editorLangId == verilog || editorLangId == systemverilog"
      },
      {
        "command": "veriflow.openSchematic",
        "title": "Open as VeriFlow Schematic",
        "category": "VeriFlow",
        "icon": "$(circuit-board)"
      },
      {
        "command": "veriflow.openSchematicFromExplorer",
        "title": "Open as VeriFlow Schematic",
        "category": "VeriFlow",
        "icon": "$(circuit-board)"
      },
      {
        "command": "veriflow.scanModules",
        "title": "Scan Modules",
        "icon": "$(refresh)"
      },
      {
        "command": "veriflow.instantiateModule",
        "title": "Instantiate Module",
        "category": "VeriFlow",
        "icon": "$(symbol-method)"
      },
      {
        "command": "veriflow.showOutput",
        "title": "Show Output Panel",
        "icon": "$(output)"
      },
      {
        "command": "veriflow.createArchDesign",
        "title": "Create Architecture Design",
        "category": "VeriFlow",
        "icon": "$(add)"
      },
      {
        "command": "veriflow.refreshArchDesigns",
        "title": "Refresh Arch Designs",
        "category": "VeriFlow",
        "icon": "$(refresh)"
      },
      {
        "command": "veriflow.openArchDesign",
        "title": "Open Arch Design",
        "category": "VeriFlow",
        "icon": "$(go-to-file)"
      },
      {
        "command": "veriflow.validateArchDesign",
        "title": "Validate Arch Design",
        "category": "VeriFlow",
        "icon": "$(check)"
      },
      {
        "command": "veriflow.exportArchDesign",
        "title": "Export Arch Design RTL",
        "category": "VeriFlow",
        "icon": "$(export)"
      },
      {
        "command": "veriflow.newSimulationTask",
        "title": "Create Simulation Task",
        "category": "VeriFlow",
        "icon": "$(add)"
      },
      {
        "command": "veriflow.generateTestbench",
        "title": "Generate Testbench for Current Design",
        "category": "VeriFlow",
        "icon": "$(file-code)"
      },
      {
        "command": "veriflow.runSimulationTask",
        "title": "Run Simulation Task",
        "category": "VeriFlow",
        "icon": "$(run)"
      },
      {
        "command": "veriflow.openSimulationTask",
        "title": "Open Current Simulation Task",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.cancelSimulationTask",
        "title": "Cancel Simulation Task",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.insertHdlTemplate",
        "title": "Insert HDL Template",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.insertHdlTemplate.clock",
        "title": "HDL: Insert Clock",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.insertHdlTemplate.reset",
        "title": "HDL: Insert Reset",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.insertHdlTemplate.timeout",
        "title": "HDL: Insert Timeout",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.insertHdlTemplate.waveform",
        "title": "HDL: Insert Waveform",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.runTraditionalTestbench",
        "title": "Run Current Testbench",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.selectTraditionalTestbench",
        "title": "Run Existing Testbench",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.cancelTraditionalTestbench",
        "title": "Stop Traditional Testbench",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.previewArchDesignRtl",
        "title": "View AD RTL",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.openModuleBrowserModule",
        "title": "Open Module Declaration",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.copyInstantiation",
        "title": "Copy Module Instantiation",
        "category": "VeriFlow"
      },
      {
        "command": "veriflow.newHdlFile",
        "title": "New HDL File",
        "category": "VeriFlow",
        "icon": "$(add)"
      },
      {
        "command": "veriflow.addModuleToCanvas",
        "title": "Add to Canvas",
        "category": "VeriFlow",
        "enablement": "veriflow.activeCanvas"
      },
      {
        "command": "veriflow.exportSimulationTestbench",
        "title": "Generate Testbench",
        "category": "VeriFlow",
        "icon": "$(export)"
      },
      {
        "command": "veriflow.openSimulationTaskWave",
        "title": "Open Simulation Waveform",
        "category": "VeriFlow",
        "icon": "$(pulse)"
      },
      {
        "command": "veriflow.bindArchDesignPins",
        "title": "Board / Pin Bindings (AD)",
        "category": "VeriFlow",
        "icon": "$(circuit-board)"
      },
      {
        "command": "veriflow.generatePinConstraints",
        "title": "Generate Pin Constraints (XDC)",
        "category": "VeriFlow",
        "icon": "$(circuit-board)"
      },
      {
        "command": "veriflow.manageBoards",
        "title": "Manage Boards",
        "category": "VeriFlow",
        "icon": "$(circuit-board)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "veriflow.hdl",
          "when": "editorLangId == verilog || editorLangId == systemverilog || resourceExtname == .ad",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "veriflow.openSchematicFromExplorer",
          "when": "resourceExtname == .v || resourceExtname == .sv",
          "group": "navigation@9"
        },
        {
          "command": "veriflow.openVcdViewer",
          "when": "resourceExtname == .vcd",
          "group": "navigation@10"
        },
        {
          "submenu": "veriflow.hdl",
          "when": "resourceExtname == .v || resourceExtname == .sv || resourceExtname == .ad",
          "group": "veriflow@8"
        }
      ],
      "editor/title": [
        {
          "command": "veriflow.openSchematic",
          "when": "editorLangId == verilog || editorLangId == systemverilog",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "veriflow.scanModules",
          "when": "view == veriflow.files",
          "group": "navigation@1"
        },
        {
          "command": "veriflow.newHdlFile",
          "when": "view == veriflow.files",
          "group": "navigation@3"
        },
        {
          "command": "veriflow.createArchDesign",
          "when": "view == veriflow.design",
          "group": "navigation@1"
        },
        {
          "command": "veriflow.newSimulationTask",
          "when": "view == veriflow.modules",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "veriflow.openArchDesign",
          "when": "view == veriflow.design && viewItem == archDesignFile",
          "group": "navigation@1"
        },
        {
          "command": "veriflow.validateArchDesign",
          "when": "view == veriflow.design && viewItem == archDesignFile",
          "group": "navigation@2"
        },
        {
          "command": "veriflow.exportArchDesign",
          "when": "view == veriflow.design && viewItem == archDesignFile",
          "group": "navigation@3"
        },
        {
          "command": "veriflow.bindArchDesignPins",
          "when": "view == veriflow.design && viewItem == archDesignFile",
          "group": "navigation@4"
        }
      ],
      "webview/context": [
        {
          "command": "veriflow.addModuleToCanvas",
          "when": "webviewId == veriflow.files && webviewSection == hdlModule",
          "group": "navigation@1"
        },
        {
          "command": "veriflow.openModuleBrowserModule",
          "when": "webviewId == veriflow.files && webviewSection == hdlModule",
          "group": "navigation@2"
        },
        {
          "command": "veriflow.copyInstantiation",
          "when": "webviewId == veriflow.files && webviewSection == hdlModule",
          "group": "navigation@3"
        }
      ],
      "veriflow.hdl": [
        {
          "command": "veriflow.insertHdlTemplate",
          "when": "editorLangId == verilog || editorLangId == systemverilog || resourceExtname == .v || resourceExtname == .sv",
          "group": "1_edit@1"
        },
        {
          "command": "veriflow.instantiateModule",
          "when": "editorLangId == verilog || editorLangId == systemverilog || resourceExtname == .v || resourceExtname == .sv",
          "group": "1_edit@2"
        },
        {
          "command": "veriflow.formatHdl",
          "when": "editorLangId == verilog || editorLangId == systemverilog || resourceExtname == .v || resourceExtname == .sv",
          "group": "1_edit@3"
        },
        {
          "command": "veriflow.runTraditionalTestbench",
          "when": "editorLangId == verilog || editorLangId == systemverilog || resourceExtname == .v || resourceExtname == .sv",
          "group": "2_simulation@1"
        },
        {
          "command": "veriflow.generatePinConstraints",
          "when": "resourceExtname == .v || resourceExtname == .sv",
          "group": "3_physical@1"
        },
        {
          "command": "veriflow.bindArchDesignPins",
          "when": "resourceExtname == .ad",
          "group": "3_physical@2"
        }
      ],
      "commandPalette": [
        {
          "command": "veriflow.manageBoards",
          "when": "true"
        },
        {
          "command": "veriflow.bindArchDesignPins",
          "when": "resourceExtname == .ad || activeCustomEditorId == veriflow.archDesignEditor"
        },
        {
          "command": "veriflow.generatePinConstraints",
          "when": "resourceExtname == .v || resourceExtname == .sv"
        },
        {
          "command": "veriflow.analyze",
          "when": "false"
        },
        {
          "command": "veriflow.simulate",
          "when": "false"
        },
        {
          "command": "veriflow.openWave",
          "when": "false"
        },
        {
          "command": "veriflow.openVcdViewer",
          "when": "true"
        },
        {
          "command": "veriflow.formatHdl",
          "when": "editorLangId == verilog || editorLangId == systemverilog"
        },
        {
          "command": "veriflow.openSchematic",
          "when": "editorLangId == verilog || editorLangId == systemverilog"
        },
        {
          "command": "veriflow.openSchematicFromExplorer",
          "when": "false"
        },
        {
          "command": "veriflow.scanModules",
          "when": "true"
        },
        {
          "command": "veriflow.instantiateModule",
          "when": "editorLangId == verilog || editorLangId == systemverilog"
        },
        {
          "command": "veriflow.showOutput",
          "when": "true"
        },
        {
          "command": "veriflow.createArchDesign",
          "when": "true"
        },
        {
          "command": "veriflow.refreshArchDesigns",
          "when": "false"
        },
        {
          "command": "veriflow.openArchDesign",
          "when": "false"
        },
        {
          "command": "veriflow.validateArchDesign",
          "when": "false"
        },
        {
          "command": "veriflow.exportArchDesign",
          "when": "false"
        },
        {
          "command": "veriflow.newSimulationTask",
          "when": "true"
        },
        {
          "command": "veriflow.generateTestbench",
          "when": "false"
        },
        {
          "command": "veriflow.runSimulationTask",
          "when": "activeCustomEditorId == veriflow.simulationTask"
        },
        {
          "command": "veriflow.openSimulationTask",
          "when": "false"
        },
        {
          "command": "veriflow.cancelSimulationTask",
          "when": "activeCustomEditorId == veriflow.simulationTask"
        },
        {
          "command": "veriflow.insertHdlTemplate",
          "when": "editorLangId == verilog || editorLangId == systemverilog"
        },
        {
          "command": "veriflow.insertHdlTemplate.clock",
          "when": "false"
        },
        {
          "command": "veriflow.insertHdlTemplate.reset",
          "when": "false"
        },
        {
          "command": "veriflow.insertHdlTemplate.timeout",
          "when": "false"
        },
        {
          "command": "veriflow.insertHdlTemplate.waveform",
          "when": "false"
        },
        {
          "command": "veriflow.runTraditionalTestbench",
          "when": "editorLangId == verilog || editorLangId == systemverilog"
        },
        {
          "command": "veriflow.selectTraditionalTestbench",
          "when": "true"
        },
        {
          "command": "veriflow.cancelTraditionalTestbench",
          "when": "false"
        },
        {
          "command": "veriflow.previewArchDesignRtl",
          "when": "false"
        },
        {
          "command": "veriflow.openModuleBrowserModule",
          "when": "false"
        },
        {
          "command": "veriflow.copyInstantiation",
          "when": "false"
        },
        {
          "command": "veriflow.newHdlFile",
          "when": "true"
        },
        {
          "command": "veriflow.addModuleToCanvas",
          "when": "false"
        },
        {
          "command": "veriflow.exportSimulationTestbench",
          "when": "activeCustomEditorId == veriflow.simulationTask"
        },
        {
          "command": "veriflow.openSimulationTaskWave",
          "when": "activeCustomEditorId == veriflow.simulationTask"
        }
      ]
    },
    "configuration": {
      "title": "VeriFlow",
      "properties": {
        "veriflow.formatting.alignment": {
          "type": "string",
          "enum": [
            "columns",
            "adaptive"
          ],
          "default": "columns",
          "scope": "language-overridable",
          "description": "HDL formatting alignment: fixed five-column offsets or the previous adaptive alignment. Applies to Format Document and Format HDL; does not reformat AD/ST exports."
        },
        "veriflow.formatting.columns": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240
          },
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "default": [
            4,
            12,
            20,
            44,
            56
          ],
          "scope": "language-overridable",
          "description": "Five strictly increasing zero-based space offsets. The first (1–8) also sets indentation. Defaults place keywords, types, widths, names, and delimiters at offsets 4, 12, 20, 44, and 56; parameter '=' uses the last column. Content past a target keeps minimal spacing without moving other lines."
        },
        "veriflow.hdlTemplates": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "markdownDescription": "Add, override, or disable HDL templates by ID in settings.json. Overrides retain unspecified built-in fields. Supports {{1:default}}, {{1}} mirrors, and {{0}}; HDL $tasks remain literal text. Changes apply on the next insertion in the current document.",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_-]*$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "description": "Display name; defaults to the built-in label or the new template ID."
                },
                "description": {
                  "type": "string",
                  "description": "Description shown in the template picker."
                },
                "body": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "items": {
                    "type": "string"
                  },
                  "description": "Template text or lines joined with a newline. Required for new templates; an empty body inserts nothing. Placeholder defaults cannot contain a right brace."
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "verilog",
                      "systemverilog"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true,
                  "description": "Supported document languages; defaults to Verilog and SystemVerilog."
                },
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Set false to hide this template, including from legacy template commands."
                }
              }
            }
          }
        },
        "veriflow.libDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Library directories for VeriFlow module search and dependency resolution"
        },
        "veriflow.defines": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "description": "SystemVerilog preprocessor defines used by VeriFlow structural parsing"
        },
        "veriflow.simulator": {
          "type": "string",
          "enum": [
            "builtin",
            "custom"
          ],
          "default": "builtin",
          "description": "Simulation backend. 'builtin' uses the bundled Icarus Verilog WebAssembly runtime for Verilog-2005; choose 'custom' for an external simulator."
        },
        "veriflow.simulatorCompileCmd": {
          "type": "string",
          "default": "",
          "description": "Custom compile command template. Use {files}, {output}, and {top_module}. Examples: Icarus Verilog: iverilog -g2005 -o \"{output}\" {files}; VCS: vcs -full64 -o \"{output}\" {files}; XSim: xvlog {files} && xelab {top_module} -snapshot \"{output}\"."
        },
        "veriflow.simulatorRunCmd": {
          "type": "string",
          "default": "",
          "description": "Custom run command template. Use {output}. Examples: Icarus Verilog: vvp \"{output}\"; VCS: ./\"{output}\"; XSim: xsim \"{output}\" --runall."
        },
        "veriflow.waveViewer": {
          "type": "string",
          "enum": [
            "builtin",
            "custom"
          ],
          "default": "builtin",
          "description": "Waveform viewer. 'builtin' opens VCD files in VeriFlow; choose 'custom' to launch an external viewer."
        },
        "veriflow.waveViewerCmd": {
          "type": "string",
          "default": "",
          "description": "Custom wave viewer command template. Use {wave_file}. Examples: Surfer: surfer \"{wave_file}\"; GTKWave: gtkwave \"{wave_file}\"."
        },
        "veriflow.waveFileTemplate": {
          "type": "string",
          "default": "{top_module}.vcd",
          "description": "Waveform file path template. Use {top_module} as placeholder."
        },
        "veriflow.testbenchOutputDir": {
          "type": "string",
          "default": ".",
          "description": "Directory where generated testbench files are written. Relative paths are resolved from the workspace root."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "*.st",
        "url": "./schemas/simulation-task.schema.json"
      }
    ],
    "submenus": [
      {
        "id": "veriflow.hdl",
        "label": "VeriFlow"
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node ../scripts/build-vscode.mjs",
    "compile:ts": "tsc -p ./",
    "bundle": "node ./scripts/build.mjs",
